{
  "name": "virtfusion-ts",
  "version": "0.1.0",
  "description": "A client for VirtFusion API. Built with TypeScript.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "setup-dev": "git clone git@github.com:Lazco-Studio/VirtFusion-Test.git ../VirtFusion-Test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhoishCore/VirtFusion-ts.git"
  },
  "keywords": ["VirtFusion", "api", "typescript", "async", "promise"],
  "author": "whoish",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/WhoishCore/VirtFusion-ts/issues"
  },
  "homepage": "https://github.com/WhoishCore/VirtFusion-ts/wiki",
  "packageManager": "pnpm@9.14.4",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "url-join-ts": "^1.0.5"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@biomejs/biome": "^1.9.4",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.1",
    "@types/tcp-ping": "^0.1.6",
    "tcp-ping": "^0.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "_moduleAliases": {
    "types": "./dist/types",
    "modules": "./dist/modules"
  }
}
